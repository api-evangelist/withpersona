{
  "opencollection": "1.0.0",
  "info": {
    "name": "Persona Accounts Reports API",
    "version": "2023-01-05"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withpersona.com/api/v1/reports",
            "params": [
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "Cursor for the object after which to start the page."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of results per page (max 100)."
              }
            ]
          },
          "docs": "List all Reports"
        },
        {
          "info": {
            "name": "Create a Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withpersona.com/api/v1/reports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Runs a watchlist, adverse-media, PEP, or business lookup Report."
        },
        {
          "info": {
            "name": "Retrieve a Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withpersona.com/api/v1/reports/:report-id",
            "params": [
              {
                "name": "report-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a Report"
        }
      ]
    }
  ],
  "bundled": true
}