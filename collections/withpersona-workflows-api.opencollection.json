{
  "opencollection": "1.0.0",
  "info": {
    "name": "Persona Accounts Workflows API",
    "version": "2023-01-05"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Workflow Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withpersona.com/api/v1/workflow-runs",
            "params": [
              {
                "name": "page[after]",
                "value": "",
                "type": "query",
                "description": "Cursor for the object after which to start the page."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of results per page (max 100)."
              }
            ]
          },
          "docs": "List all Workflow Runs"
        },
        {
          "info": {
            "name": "Create a Workflow Run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withpersona.com/api/v1/workflow-runs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Workflow Run"
        },
        {
          "info": {
            "name": "Retrieve a Workflow Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withpersona.com/api/v1/workflow-runs/:workflow-run-id",
            "params": [
              {
                "name": "workflow-run-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a Workflow Run"
        }
      ]
    }
  ],
  "bundled": true
}