                "name": "case-id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Case"
        },
        {
          "info": {
            "name": "Assign a Case",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withpersona.com/api/v1/cases/:case-id/assign",
            "params": [
              {
                "name": "case-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Assign a Case"
        }
      ]
    }
