{
  "opencollection": "1.0.0",
  "info": {
    "name": "Persona Accounts Cases API",
    "version": "2023-01-05"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cases",
