                "description": "Cursor for the object after which to start the page."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of results per page (max 100)."
              }
            ]
          },
          "docs": "List all Cases"
        },
        {
          "info": {
            "name": "Create a Case",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.withpersona.com/api/v1/cases",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Case"
        },
        {
          "info": {
            "name": "Retrieve a Case",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.withpersona.com/api/v1/cases/:case-id",
            "params": [
              {
                "name": "case-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a Case"
        },
        {
          "info": {
            "name": "Update a Case",
            "type": "http"
          },
          "http": {
